# Gmail SMTP (email delivery via nodemailer)
# Use a Gmail address + an App Password (NOT your regular Gmail password)
# Steps: Google Account → Security → 2-Step Verification ON → App Passwords → generate one
GMAIL_USER=
GMAIL_APP_PASSWORD=
